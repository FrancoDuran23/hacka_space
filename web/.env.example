# Copiá a .env.local. Wallet DESCARTABLE solo de testnet (Fuji).
# Clave del relayer: firma attestReentry desde /api/relayer (solo servidor, nunca NEXT_PUBLIC_).
# Tiene que ser la dirección "relayer" del contrato (inmutable): ver contratos/README.md.
RELAYER_PRIVATE_KEY=0x_tu_clave_de_testnet
# RPC opcional (por defecto el público de Fuji)
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# --- Login y cuenta (Neon Auth + Postgres) ---
# Neon Console → Project → Connect (usar la cadena con pooling)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Console → Branch → Auth → Configuration → Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Generar con: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=cambia-este-secreto-de-al-menos-32-caracteres

# --- Panel de administración (/admin) ---
# Emails con acceso al panel /admin (separados por coma)
ADMIN_EMAILS="admin@orbitclear.dev"
